{
  "id": "freewifi",
  "name": "FreeWifi",
  "version": 1,
  "initialMessage": {
    "role": "assistant",
    "content": "Hello! I'll help you create your FreeWifi. Let's start — what is the **title of the activity**?"
  },
  "fields": [
    {
      "id": "title",
      "label": "Activity title",
      "type": "text"
    },
    {
      "id": "dateTime",
      "label": "Date and time",
      "type": "text",
      "example": "\"December 2-3, 2025 | 9:00am - 5:00pm\""
    },
    {
      "id": "mode",
      "label": "Mode/Platform/Location",
      "type": "text"
    },
    {
      "id": "facilitators",
      "label": "DICT Facilitators",
      "type": "list",
      "itemLabel": "Facilitator",
      "collectNote": "Ask how many facilitators first, then collect each one (Name, Office, Gender M/F).",
      "doneAccepted": true,
      "itemFields": [
        {
          "id": "name",
          "type": "text"
        },
        {
          "id": "office",
          "type": "text"
        },
        {
          "id": "gender",
          "type": "text",
          "example": "M/F"
        }
      ]
    },
    {
      "id": "beneficiaries",
      "label": "Beneficiary breakdown",
      "type": "beneficiaries",
      "sectionTitle": "NGAs / LGUs / SUCs and other Beneficiaries",
      "categories": [
        {
          "id": "ngas",
          "label": "NGAs"
        },
        {
          "id": "lgus",
          "label": "LGUs"
        },
        {
          "id": "sucs",
          "label": "SUCs"
        },
        {
          "id": "others",
          "label": "Others"
        }
      ]
    },
    {
      "id": "rationale",
      "label": "What was the activity about?",
      "target": "Rationale",
      "type": "longform",
      "styleNote": "Write in formal, professional government report style (2-3 paragraphs)"
    },
    {
      "id": "highlights",
      "label": "Key topics/modules discussed and outcomes",
      "target": "Highlights",
      "type": "longform",
      "styleNote": "Write in formal, professional government report style (2-3 paragraphs)"
    },
    {
      "id": "preparedBy",
      "label": "Prepared by",
      "type": "person",
      "manual": true
    },
    {
      "id": "conformedBy",
      "label": "Conformed by",
      "type": "person",
      "manual": true
    }
  ],
  "personnel": [],
  "promptNotes": []
}
